# Pengaturan server Phsar. Di server:  cp env.production.example .env  lalu isi.
# File .env berisi rahasia: JANGAN di-commit, JANGAN dikirim ke chat. Simpan salinannya di password manager.
# Nilai acak dibuat dengan:  openssl rand -hex 32   (atau ./phsar.sh secrets untuk membuat semuanya sekaligus)

# ---- Domain & HTTPS ----
# Domain tanpa https:// dan tanpa www, mis. phsar.com.kh. DNS (A record) harus sudah mengarah ke IP server.
PHSAR_DOMAIN=
# Email untuk Let's Encrypt (pemberitahuan sertifikat).
ACME_EMAIL=
# Harus sama dengan domain di atas, pakai https://
PUBLIC_BASE_URL=https://

# ---- Database ----
# Hanya huruf/angka (dipakai di URL koneksi): openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Umum ----
DEFAULT_LANG=km
LOG_LEVEL=info

# ---- Login ----
# openssl rand -hex 32 — BEDA dengan yang di laptop
JWT_SECRET=
# Bot Telegram PRODUKSI dari @BotFather (bukan bot dev). Set juga /setdomain di @BotFather ke domain di atas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# webhook = server memberi tahu Telegram alamat https://<domain>/webhooks/telegram/<key> otomatis saat start
TELEGRAM_MODE=webhook
# openssl rand -hex 16
TELEGRAM_WEBHOOK_KEY=
# off = login hanya lewat Telegram sampai ada provider SMS Kamboja (log tidak boleh di production)
SMS_PROVIDER=off

# ---- Kunci enkripsi rekening seller ----
# openssl rand -base64 32 — JANGAN PERNAH diganti / hilang setelah ada data. Simpan di password manager.
DATA_ENCRYPTION_KEY=

# ---- Pembayaran ----
# Sebaiknya diatur dari admin: menu "Payment gateway" (khusus super admin) — kredensial PayWay disimpan terenkripsi di database
# dan mode (tutup / PayWay) bisa diganti tanpa restart. Nilai di bawah hanya cadangan selama admin belum pernah menyimpan.
# off = PRA-PELUNCURAN: website tampil + seller bisa daftar & upload produk, tapi pembeli belum bisa checkout.
# payway = buka belanja (isi PAYWAY_* dengan kunci PRODUKSI dari ABA).
PAYMENT_PROVIDER=off
PAYWAY_BASE_URL=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYMENT_LIFETIME_MIN=15

# ---- Terjemahan AI ----
TRANSLATOR=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_FALLBACK=google
# Kunci AI sebaiknya diisi di Admin → Integrasi → AI & terjemahan (Anthropic utama, Gemini cadangan). Di sini hanya cadangan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Google Maps / Places (kunci browser, batasi ke https://<domain>/* di Google Cloud) ----
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ---- Backup ----
# Jam backup harian (waktu Phnom Penh) dan berapa hari dump database disimpan.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
