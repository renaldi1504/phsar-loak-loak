# Salin ke .env lalu sesuaikan. Jangan commit file .env.
APP_ENV=development
# Khusus development: login admin tanpa kode authenticator (MFA). Isi false untuk menguji MFA. Diabaikan di staging/production.
ADMIN_MFA_SKIP=true
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://phsar:phsar@localhost:5433/phsar?sslmode=disable
DEFAULT_LANG=en
LOG_LEVEL=debug

# Login
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Dari @BotFather. Kosongkan untuk menonaktifkan login Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling = laptop (tanpa domain publik) · webhook = server
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_KEY=
# log = kode OTP SMS ditulis ke log server (hanya untuk pengembangan) · off = login SMS mati, hanya Telegram (server sebelum ada provider SMS)
SMS_PROVIDER=log

# File upload (sementara disk lokal; nanti Cloudflare R2). Relatif terhadap folder backend/.
STORAGE_DIR=./data/uploads

# Terjemahan AI (produk, toko, chat)
# claude = utama (Anthropic API) · google = Google Cloud Translation · off = tidak menerjemahkan
TRANSLATOR=claude
# Dari https://console.anthropic.com → API Keys. Jangan commit / jangan kirim ke chat.
# Kunci AI & Google Maps sebaiknya diisi di Admin → Integrasi (terenkripsi, khusus super admin).
# Nilai di bawah hanya cadangan kalau belum diisi di admin.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Cadangan AI kalau Anthropic gagal (mis. HTTP 400 saldo habis): Gemini (aistudio.google.com → Get API key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cadangan kalau Claude gagal (opsional): API key Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_FALLBACK=google
# true = worker terjemahan ikut jalan di `make run` (cukup untuk dev). Production: false + jalankan `phsar worker` terpisah.
WORKER_IN_SERVE=true

# Google Maps + Places (pilih lokasi titik penjemputan). Kunci BROWSER — batasi per domain di Google Cloud.
# Kosong = peta OpenStreetMap biasa (klik untuk pasang pin).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Pembayaran KHQR (ABA PayWay). fake = pengembangan: layar QR palsu + tombol "simulasi bayar" (tidak boleh di production).
# off = pra-peluncuran: website + Seller Center jalan, checkout pembeli ditutup.
PAYMENT_PROVIDER=fake
# Dari ABA setelah akun merchant disetujui. Sandbox: https://checkout-sandbox.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
# Rahasia: jangan commit / jangan kirim ke chat.
PAYWAY_API_KEY=
# Berapa menit QR berlaku sebelum pesanan dibatalkan & stok dikembalikan (3–120).
PAYMENT_LIFETIME_MIN=15

# Kunci enkripsi nomor rekening seller (32 byte base64). Buat: openssl rand -base64 32
# Di laptop boleh kosong (pakai kunci pengembangan). JANGAN diganti setelah ada data — rekening lama tidak bisa dibaca lagi.
DATA_ENCRYPTION_KEY=

# Cari dengan foto: alamat layanan embedder (lihat embedder/README.md). Kosong = fitur mati.
EMBEDDER_URL=
